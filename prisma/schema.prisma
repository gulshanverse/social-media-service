datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  DESIGNER
}

enum ConfessionCategory {
  CRUSH
  ADMIRATION
  RELATIONSHIP
  FRIENDSHIP
  FUNNY
  COLLEGE_LIFE
  ADVICE
  APPRECIATION
  RANT
  CUSTOM
  OTHER
}

enum ConfessionStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ThemeStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  SCHEDULED
}

enum GarbaPostStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum GarbaPostCategory {
  PARTNER
  GROUP
  FRIENDS
  EVENT
  PRACTICE
  GENERAL
}

enum GarbaCommentStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ConfessionCommentStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
  LOCKED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
  ARCHIVED
}
enum BawalBoxQuestionStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}
enum BawalBoxResponseStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum PermissionEffect {
  GRANT
  DENY
}

model AdminUser {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String?
  isActive       Boolean         @default(true)
  bannedAt       DateTime?
  deletedAt      DateTime?
  role           AdminRole       @default(SUPER_ADMIN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  confessions    Confession[]    @relation("ConfessionEditor")
  auditLogs      AuditLog[]      @relation("AuditActor")
  reports        Report[]        @relation("ReportReviewer")
  sessions       AdminSession[]
  themeFavorites ThemeFavorite[]
  roleAssignments AdminRoleAssignment[]
  permissionOverrides AdminPermissionOverride[]
  bawalBoxResponsesModerated BawalBoxResponse[] @relation("BawalBoxResponseModerator")
}

model AdminSession {
  id               String    @id @default(cuid())
  adminId          String
  admin            AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime?

  @@index([adminId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Theme {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String
  description      String?
  icon             String?
  category         String?
  tags             Json?
  background       String
  gradient         String
  textColor        String
  accentColor      String
  fontFamily       String
  borderStyle      String          @default("solid")
  radius           Int             @default(28)
  logoVisibility   Boolean         @default(true)
  handleVisibility Boolean         @default(true)
  layoutVariant    String          @default("classic")
  mode             String          @default("dark")
  status           ThemeStatus     @default(ACTIVE)
  startAt          DateTime?
  endAt            DateTime?
  tokens           Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  confessions      Confession[]
  favorites        ThemeFavorite[]

  @@index([status, startAt, endAt])
  @@index([mode, layoutVariant])
}

model ThemeFavorite {
  id        String    @id @default(cuid())
  adminId   String
  themeId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  theme     Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([adminId, themeId])
  @@index([adminId, createdAt])
}

model Confession {
  id              String              @id @default(cuid())
  publicId        String              @unique
  content         String
  originalContent String
  category        ConfessionCategory?
  customCategory  String?
  status          ConfessionStatus    @default(PENDING)
  themeId         String?
  theme           Theme?              @relation(fields: [themeId], references: [id])
  editorId        String?
  editor          AdminUser?          @relation("ConfessionEditor", fields: [editorId], references: [id])
  viewCount       Int                 @default(0)
  shareCount      Int                 @default(0)
  reportCount     Int                 @default(0)
  commentsLocked  Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  publishedAt     DateTime?
  reports         Report[]
  comments        ConfessionComment[]
  reactions       ConfessionReaction[]

  @@index([status, createdAt])
  @@index([themeId, createdAt])
  @@index([category])
}

model Report {
  id           String       @id @default(cuid())
  confessionId String
  confession   Confession   @relation(fields: [confessionId], references: [id])
  commentId    String?
  comment      ConfessionComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  reporterHash String?
  reviewerId   String?
  reviewer     AdminUser?   @relation("ReportReviewer", fields: [reviewerId], references: [id])
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
  @@index([confessionId])
  @@index([commentId])
  @@index([reviewerId])
}

model CommenterProfile {
  id                String               @id @default(cuid())
  displayName       String
  instagramUsername String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sessions          CommenterSession[]
  comments          ConfessionComment[]
  reactions         ConfessionReaction[]

  @@index([instagramUsername])
}

model CommenterSession {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  profileId  String
  profile    CommenterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())
  lastUsedAt DateTime?

  @@index([profileId])
  @@index([expiresAt, revokedAt])
}

model ConfessionComment {
  id           String                  @id @default(cuid())
  confessionId String
  confession   Confession              @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  profileId    String
  profile      CommenterProfile        @relation(fields: [profileId], references: [id], onDelete: Restrict)
  parentId     String?
  parent       ConfessionComment?      @relation("ConfessionCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ConfessionComment[]     @relation("ConfessionCommentReplies")
  content      String
  status       ConfessionCommentStatus @default(PENDING)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  reports      Report[]

  @@index([confessionId, status, parentId, createdAt])
  @@index([parentId, status, createdAt])
  @@index([profileId, createdAt])
}

model ConfessionReaction {
  id           String            @id @default(cuid())
  confessionId String
  confession   Confession        @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  profileId    String?
  profile      CommenterProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  actorHash    String
  emoji        String
  createdAt    DateTime          @default(now())

  @@unique([confessionId, actorHash, emoji])
  @@index([confessionId, emoji])
}

model AuditLog {
  id        String     @id @default(cuid())
  actorId   String?
  actor     AdminUser? @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entity, createdAt])
  @@index([entityId])
}

model Permission {
  key         String   @id
  description String
  reserved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  rolePermissions AdminRolePermission[]
  overrides       AdminPermissionOverride[]
}

model AdminRoleDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions AdminRolePermission[]
  assignments AdminRoleAssignment[]

  @@index([system, key])
}

model AdminRolePermission {
  roleId        String
  permissionKey String
  role          AdminRoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission          @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

model AdminRoleAssignment {
  adminId   String
  roleId    String
  admin     AdminUser           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role      AdminRoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([adminId, roleId])
  @@index([roleId])
}

model AdminPermissionOverride {
  adminId       String
  permissionKey String
  effect        PermissionEffect
  admin         AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@id([adminId, permissionKey])
  @@index([permissionKey, effect])
}

model CollegeConfessionProfileSettings {
  id                       String   @id @default("default")
  handle                   String   @default("@college.confession.ggv")
  headerMessage            String   @default("send me anonymous weekly Confession!")
  defaultPrompt            String   @default("Are u talking to anyone??")
  communityButtonText      String   @default("Visit Community")
  communityPath            String   @default("/confessions")
  bottomButtonText         String   @default("Get your own messages!")
  profileImageUrl          String?
  themePreset              String   @default("sunset")
  maxCharacters            Int      @default(1000)
  cardTextSize             Int      @default(16)
  previewLines             Int      @default(5)
  prompts                  Json
  readLiveConfessionButton Json?
  updatedAt                DateTime @updatedAt
  updatedBy                String?

  @@index([updatedAt])
}

model BawalBoxSettings {
  id                        String   @id @default("default")
  brandName                 String   @default("BawalBox")
  tagline                   String   @default("Sawaal ek, bawal anek!")
  shortDescription          String   @default("Anonymous campus questions, honest answers, and a little good-natured bawal.")
  longDescription           String   @default("Ask the question everyone is thinking and let your campus answer anonymously. Responses are reviewed before they appear.")
  logoUrl                   String?
  accentColor               String   @default("#ff2d75")
  seoTitle                  String   @default("BawalBox — Anonymous campus questions")
  seoDescription            String   @default("Ask, answer, and discover the questions shaping campus life.")
  socialTitle               String   @default("BawalBox — Sawaal ek, bawal anek!")
  socialDescription         String   @default("Anonymous campus questions and community answers.")
  socialImageUrl            String?
  homepageTeaserTitle       String   @default("Ask the question everyone is thinking.")
  homepageTeaserDescription String   @default("BawalBox is now open for anonymous campus questions.")
  homepageTeaserCta         String   @default("Open BawalBox")
  navLabel                  String   @default("BawalBox")
  navVisible                Boolean  @default(true)
  teaserVisible             Boolean  @default(true)
  introTitle                String   @default("The question is anonymous. The bawal is communal.")
  introDescription          String   @default("Share a question, read what your campus thinks, and keep it kind. No public profile required.")
  introCta                  String   @default("Ask anonymously")
  archivedVisible           Boolean  @default(true)
  emptyStateText            String   @default("No question is live right now. Check back soon for the next one.")
  heroEnabled               Boolean  @default(true)
  heroHeading               String   @default("BawalBox is open")
  heroSubtitle              String   @default("One question. Many campus answers.")
  heroTagline               String   @default("Sawaal ek, bawal anek!")
  heroCtaLabel              String   @default("Try the question")
  heroCtaUrl                String   @default("/bawalbox")
  heroDesktopImageUrl       String?
  heroMobileImageUrl        String?
  heroAltText               String   @default("BawalBox anonymous campus questions")
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?
}

model BawalBoxQuestion {
  id           String                @id @default(cuid())
  title        String
  description  String?
  instructions String?
  category     String?
  startAt      DateTime?
  endAt        DateTime?
  status       BawalBoxQuestionStatus @default(DRAFT)
  featured     Boolean               @default(false)
  answerLimit  Int?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  publishedAt  DateTime?
  responses    BawalBoxResponse[]
  @@index([status, startAt, endAt])
  @@index([featured, status])
}

model BawalBoxResponse {
  id          String               @id @default(cuid())
  questionId  String
  question    BawalBoxQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content     String
  status      BawalBoxResponseStatus @default(PENDING)
  pinned      Boolean              @default(false)
  moderatorId String?
  moderator   AdminUser?           @relation("BawalBoxResponseModerator", fields: [moderatorId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  moderatedAt DateTime?
  @@index([questionId, status, pinned, createdAt])
  @@index([status, createdAt])
}

model GarbaSeason {
  id        String      @id @default(cuid())
  name      String
  year      Int
  startDate DateTime?
  endDate   DateTime?
  status    String      @default("ACTIVE")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  posts     GarbaPost[]

  @@index([status, year])
}

model GarbaPost {
  id              String            @id @default(cuid())
  publicId        String            @unique
  seasonId        String?
  season          GarbaSeason?      @relation(fields: [seasonId], references: [id])
  category        GarbaPostCategory
  content         String
  themeId         String?
  eventDate       DateTime?
  location        String?
  instagramHandle String?
  authorHash      String
  status          GarbaPostStatus   @default(PENDING)
  commentsLocked  Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  publishedAt     DateTime?
  comments        GarbaComment[]
  reactions       GarbaReaction[]
  reports         GarbaReport[]

  @@index([status, createdAt])
  @@index([seasonId, createdAt])
  @@index([themeId])
}

model GarbaComment {
  id         String             @id @default(cuid())
  postId     String
  post       GarbaPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     GarbaComment?      @relation("GarbaCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    GarbaComment[]     @relation("GarbaCommentReplies")
  content    String
  authorHash String
  status     GarbaCommentStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  reports    GarbaReport[]

  @@index([postId, status, createdAt])
}

model GarbaReaction {
  id        String    @id @default(cuid())
  postId    String
  post      GarbaPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorHash String
  createdAt DateTime  @default(now())

  @@unique([postId, actorHash])
}

model GarbaReport {
  id           String        @id @default(cuid())
  postId       String
  post         GarbaPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      GarbaComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason       String
  reporterHash String
  status       ReportStatus  @default(OPEN)
  createdAt    DateTime      @default(now())

  @@index([status, createdAt])
  @@index([postId])
}

enum VibeIdentityStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VibeProfileStatus {
  ACTIVE
  PAUSED
  HIDDEN
  DELETED
}

enum VibeSessionStatus {
  PLAYING
  COMPLETED
  ABANDONED
}

model VibeIdentity {
  id             String                @id @default(cuid())
  emailHash      String                @unique
  ageConfirmed   Boolean               @default(false)
  status         VibeIdentityStatus    @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  sessions       VibeIdentitySession[]
  profile        VibeProfile?
  magicLinks     VibeMagicLink[]
  blocksMade     VibeBlock[]           @relation("VibeBlocker")
  blocksReceived VibeBlock[]           @relation("VibeBlocked")

  @@index([status, createdAt])
}

model VibeIdentitySession {
  id         String       @id @default(cuid())
  identityId String
  identity   VibeIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  tokenHash  String       @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?

  @@index([identityId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model VibeGuestSession {
  id                String        @id @default(cuid())
  displayName       String
  instagramUsername String
  tokenHash         String        @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime      @default(now())
  lastUsedAt        DateTime?
  gameSessions      VibeSession[]

  @@index([expiresAt])
  @@index([revokedAt])
}

model VibeBlock {
  id                String       @id @default(cuid())
  blockerIdentityId String
  blocker           VibeIdentity @relation("VibeBlocker", fields: [blockerIdentityId], references: [id], onDelete: Cascade)
  blockedIdentityId String
  blocked           VibeIdentity @relation("VibeBlocked", fields: [blockedIdentityId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@unique([blockerIdentityId, blockedIdentityId])
  @@index([blockedIdentityId, blockerIdentityId])
}

model VibeMagicLink {
  id         String        @id @default(cuid())
  identityId String?
  identity   VibeIdentity? @relation(fields: [identityId], references: [id], onDelete: Cascade)
  emailHash  String
  tokenHash  String        @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime      @default(now())

  @@index([emailHash, createdAt])
  @@index([expiresAt])
}

model VibeCollege {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  profiles  VibeProfile[]

  @@index([active, name])
}

model VibeProfile {
  id                String            @id @default(cuid())
  identityId        String            @unique
  identity          VibeIdentity      @relation(fields: [identityId], references: [id], onDelete: Cascade)
  discoveryKey      String            @unique @default(uuid())
  displayName       String
  instagramUsername String?
  collegeId         String
  college           VibeCollege       @relation(fields: [collegeId], references: [id])
  primaryIntent     String
  secondaryIntent   String?
  interests         Json?
  status            VibeProfileStatus @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sessions          VibeSession[]

  @@index([collegeId, status])
  @@index([status, updatedAt])
}

model VibeSession {
  id             String              @id @default(cuid())
  profileId      String?
  profile        VibeProfile?        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  guestSessionId String?
  guestSession   VibeGuestSession?   @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  seed           Int
  totalRounds    Int
  currentRound   Int                 @default(0)
  questionIds    Json
  status         VibeSessionStatus   @default(PLAYING)
  scoringVersion String
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  updatedAt      DateTime            @updatedAt
  answers        VibeSessionAnswer[]
  dnaSnapshots   VibeDnaSnapshot[]

  @@index([profileId, status, updatedAt])
  @@index([guestSessionId, status, updatedAt])
}

model VibeSessionAnswer {
  id             String      @id @default(cuid())
  sessionId      String
  session        VibeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  round          Int
  questionId     String
  optionId       String
  contribution   Json
  idempotencyKey String
  answeredAt     DateTime    @default(now())

  @@unique([sessionId, questionId])
  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, round])
}

model VibeDnaSnapshot {
  id             String      @id @default(cuid())
  sessionId      String
  session        VibeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scoringVersion String
  socialEnergy   Int
  adventure      Int
  spontaneity    Int
  humor          Int
  communication  Int
  intent         Int
  coverage       Int
  answerCount    Int
  calculatedAt   DateTime    @default(now())

  @@index([sessionId, calculatedAt])
}
