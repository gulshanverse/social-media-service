datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  DESIGNER
}

enum ConfessionCategory {
  CRUSH
  RELATIONSHIP
  FRIENDSHIP
  FUNNY
  COLLEGE_LIFE
  ADVICE
  APPRECIATION
  RANT
  OTHER
}

enum ConfessionStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
  ARCHIVED
}

model AdminUser {
  id          String      @id @default(cuid())
  email       String      @unique
  passwordHash String
  name        String?
  isActive    Boolean     @default(true)
  role        AdminRole   @default(SUPER_ADMIN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  confessions Confession[] @relation("ConfessionEditor")
  auditLogs   AuditLog[]  @relation("AuditActor")
  reports     Report[]    @relation("ReportReviewer")
  sessions    AdminSession[]
}

model AdminSession {
  id               String    @id @default(cuid())
  adminId          String
  admin            AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime?

  @@index([adminId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Theme {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  background       String
  gradient         String
  textColor        String
  accentColor      String
  fontFamily       String
  borderStyle      String       @default("solid")
  radius           Int          @default(28)
  logoVisibility   Boolean      @default(true)
  handleVisibility Boolean      @default(true)
  layoutVariant    String       @default("classic")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  confessions      Confession[]
}

model Confession {
  id              String             @id @default(cuid())
  publicId        String             @unique
  content         String
  originalContent String
  category        ConfessionCategory?
  status          ConfessionStatus    @default(PENDING)
  themeId         String?
  theme           Theme?              @relation(fields: [themeId], references: [id])
  editorId        String?
  editor          AdminUser?          @relation("ConfessionEditor", fields: [editorId], references: [id])
  viewCount       Int                 @default(0)
  shareCount      Int                 @default(0)
  reportCount     Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  publishedAt     DateTime?
  reports         Report[]

  @@index([status, createdAt])
  @@index([themeId, createdAt])
}

model Report {
  id           String         @id @default(cuid())
  confessionId String
  confession   Confession     @relation(fields: [confessionId], references: [id])
  reason       String
  status       ReportStatus   @default(OPEN)
  reporterHash String?
  reviewerId   String?
  reviewer     AdminUser?     @relation("ReportReviewer", fields: [reviewerId], references: [id])
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
  @@index([confessionId])
  @@index([reviewerId])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      AdminUser?  @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entity     String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entity, createdAt])
  @@index([entityId])
}

model CollegeConfessionProfileSettings {
  id                  String   @id @default("default")
  handle              String   @default("@college.confession.ggv")
  headerMessage       String   @default("send me anonymous weekly Confession!")
  defaultPrompt       String   @default("Are u talking to anyone??")
  communityButtonText String   @default("Visit Community")
  communityPath       String   @default("/confessions")
  bottomButtonText    String   @default("Get your own messages!")
  profileImageUrl     String?
  themePreset         String   @default("sunset")
  maxCharacters       Int      @default(1000)
  cardTextSize        Int      @default(16)
  previewLines        Int      @default(5)
  prompts             Json
  updatedAt           DateTime @updatedAt
  updatedBy           String?

  @@index([updatedAt])
}
