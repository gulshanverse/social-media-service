{
  "name": "social-media-service",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @ggv/web --filter @ggv/admin --filter @ggv/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ggv/config build && pnpm --filter @ggv/themes build && pnpm --filter @ggv/types build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm exec prisma generate",
    "db:push": "pnpm exec prisma db push",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy",
    "db:seed": "pnpm exec prisma db seed"
  },
  "prisma": {
    "seed": "pnpm --filter @ggv/api exec tsx ../../prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@prisma/client": "^6.2.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.4"
}
