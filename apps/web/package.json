{
  "name": "@ggv/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm --filter @ggv/config build && pnpm --filter @ggv/themes build && pnpm --filter @ggv/types build && next build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false next lint",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node -e \"console.log('web: no runtime tests')\""
  },
  "dependencies": {
    "@ggv/config": "workspace:*",
    "@ggv/themes": "workspace:*",
    "@ggv/types": "workspace:*",
    "@ggv/ui": "workspace:*",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
