DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_media_service?schema=public"
NODE_ENV="development"
PORT="4000"
# Set this to the exact fixed number of trusted reverse-proxy hops in staging/production.
TRUST_PROXY_HOPS="0"
JWT_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="replace-with-a-development-only-password"
ADMIN_LOGIN_RATE_LIMIT="5"
ADMIN_LOGIN_RATE_WINDOW_SECONDS="900"
ADMIN_REFRESH_RATE_LIMIT="10"
ADMIN_REFRESH_RATE_WINDOW_SECONDS="900"
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Leave disabled until monetization is intentionally enabled; only allowlisted information pages can load AdSense.
NEXT_PUBLIC_ADSENSE_INFO_PAGES_ENABLED="false"
WEB_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3001"
APP_VERSION="0.1.0"
GIT_COMMIT="development"
SUBMISSION_RATE_LIMIT="5"
SUBMISSION_RATE_WINDOW_SECONDS="3600"
REPORT_RATE_LIMIT="5"
REPORT_RATE_WINDOW_SECONDS="3600"
VIBEMATCH_MAGIC_LINK_RATE_LIMIT="5"
VIBEMATCH_MAGIC_LINK_RATE_WINDOW_SECONDS="900"
VIBEMATCH_SESSION_RATE_LIMIT="10"
VIBEMATCH_SESSION_RATE_WINDOW_SECONDS="3600"
